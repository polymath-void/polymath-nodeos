{
  "agy-nodeos-auto-install": {
    "WorkspaceOpen": [
      {
        "type": "command",
        "command": "python install.py",
        "timeout": 15
      }
    ]
  },
  "agy-nodeos-boot": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "pgrep -f 'nodeos.*run-as-daemon' > /dev/null || nodeos -d",
        "timeout": 5
      }
    ]
  },
  "nodeos-swarm-intent": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "nodeos -s intent_injector"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "nodeos -s intent_stopper"
      }
    ]
  }
}
